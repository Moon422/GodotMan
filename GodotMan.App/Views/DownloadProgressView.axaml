<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GodotMan.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="GodotMan.App.Views.DownloadProgressView"
             x:DataType="vm:DownloadProgressViewModel">

    <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
        <!-- Header -->
        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="Downloading Godot" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="{Binding AssetFileName}" FontSize="14" Foreground="#999999" TextAlignment="Center"/>
        </StackPanel>

        <!-- Progress Bar -->
        <StackPanel Spacing="8">
            <ProgressBar Value="{Binding Fraction}"
                         Maximum="1.0"
                         Height="24"
                         IsIndeterminate="{Binding TotalBytes, Converter={StaticResource ObjectNullToBoolConverter}}"/>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding PercentageText}" FontWeight="Bold" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Foreground="#999999" Margin="16,0"/>
                <TextBlock Grid.Column="2" Text="•" Foreground="#CCCCCC"/>
                <TextBlock Grid.Column="3" Text="{Binding EtaText}" Foreground="#999999" Margin="16,0"/>
            </Grid>
        </StackPanel>

        <!-- Status -->
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#999999" TextAlignment="Center"/>

        <!-- Controls -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CanCancel}"
                    Padding="16,8"
                    Width="100"/>
            <Button Content="Done"
                    Command="{Binding CompleteCommand}"
                    IsVisible="{Binding IsComplete}"
                    Padding="16,8"
                    Width="100"/>
        </StackPanel>
    </StackPanel>

</UserControl>
