<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GodotMan.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GodotMan.App.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="12,12,12,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Installed Godot Versions" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                <CheckBox Content="Show Installed Only"
                          IsChecked="{Binding ShowOnlyInstalled}"
                          VerticalAlignment="Center"/>

                <Button Content="↻ Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="12,6"/>

                <ProgressBar IsVisible="{Binding IsLoading}"
                             Width="20" Height="20"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <!-- Status Message -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   Foreground="#999999" Margin="12,0,12,12"/>

        <!-- Installations List -->
        <ScrollViewer DockPanel.Dock="Top">
            <ItemsControl ItemsSource="{Binding Installations}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Variant}" FontSize="11" Foreground="#999999"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#999999"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" FontSize="11" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,16,0" Name="InstalledDateBlock"/>

                                <TextBlock Grid.Column="2" FontSize="11" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,16,0" Name="LaunchedDateBlock"/>

                                <TextBlock Grid.Column="3" Text="Default"
                                           FontSize="11" Foreground="#2196F3" VerticalAlignment="Center"
                                           IsVisible="{Binding IsDefault}"/>

                                <StackPanel Grid.Column="4" Spacing="4" HorizontalAlignment="Right">
                                    <Button Content="▶ Launch" Padding="8,4"/>
                                    <Button Content="⭐ Default" Padding="8,4" IsEnabled="{Binding !IsDefault}"/>
                                    <Button Content="🗑️ Remove" Padding="8,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <TextBlock DockPanel.Dock="Top"
                   Text="No Godot installations found. Go to Releases to download and install."
                   Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="12" FontSize="14"
                   IsVisible="{Binding Installations.Count, Converter={x:Static ObjectConverters.IsNull}}"/>
    </DockPanel>

</UserControl>
