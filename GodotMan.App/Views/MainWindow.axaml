<reactiveUi:ReactiveWindow x:TypeArguments="vm:MainWindowViewModel"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:vm="using:GodotMan.App.ViewModels"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:reactiveUi="http://reactiveui.net"
                           mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
                           x:Class="GodotMan.App.Views.MainWindow"
                           x:DataType="vm:MainWindowViewModel"
                           Icon="/Assets/avalonia-logo.ico"
                           Title="GodotMan - Godot Engine Manager"
                           Width="1024" Height="768"
                           MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Top Header -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🎮" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="GodotMan" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Godot Engine Manager" FontSize="11" Foreground="#999999"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ReleaseListViewModel">
                            <Button Content="{Binding}"
                                    Command="{Binding $parent[Window].DataContext.SelectTabCommand}"
                                    CommandParameter="{Binding}"
                                    Padding="12,6" Foreground="Black"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#999999" VerticalAlignment="Center"/>
                    <ProgressBar IsVisible="{Binding IsLoading}" Width="16" Height="16" IsIndeterminate="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid ColumnDefinitions="200,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Navigation" FontSize="12" FontWeight="Bold" Foreground="#999999" Margin="0,0,0,8"/>

                    <Button Content="📦 Releases"
                            Command="{Binding NavigateToReleasesCommand}"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"/>

                    <Button Content="📁 Installed"
                            Command="{Binding NavigateToInstalledCommand}"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"/>
                </StackPanel>
            </Border>

            <!-- Content Area — ViewLocator in App.axaml handles ViewModel → View mapping -->
            <ContentControl Grid.Column="1" Content="{Binding SelectedTab}" Padding="16"/>
        </Grid>
    </DockPanel>

</reactiveUi:ReactiveWindow>
