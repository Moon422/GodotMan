<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GodotMan.App.ViewModels"
             xmlns:dto="using:GodotMan.Services.DTOs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GodotMan.App.Views.ReleaseListView"
             x:DataType="vm:ReleaseListViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="12,12,12,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Godot Releases" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Variant}" FontSize="14" Foreground="#999999" VerticalAlignment="Center"/>
                <CheckBox Content="Include Pre-releases"
                          IsChecked="{Binding IncludePreReleases}"
                          VerticalAlignment="Center"/>
                <Button Content="↻ Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="12,6"/>
                <ProgressBar IsVisible="{Binding IsLoading}"
                             Width="20" Height="20"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <!-- Status Message -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   Foreground="#999999" Margin="12,0,12,12"/>

        <!-- Releases List -->
        <ScrollViewer DockPanel.Dock="Top">
            <ItemsControl ItemsSource="{Binding Releases}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dto:ReleaseDto}">
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Stability}" FontSize="11" Foreground="#999999"/>
                                    <TextBlock Text="{Binding PublishedAt, StringFormat=\{0:MMM d, yyyy\}}"
                                               FontSize="11" Foreground="#999999"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding ReleaseNotes}"
                                           FontSize="12" TextWrapping="Wrap"
                                           MaxLines="2" VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>

                                <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Assets.Count, StringFormat=\{0\} assets}"
                                               FontSize="11" Foreground="#999999"/>
                                    <Button Content="Install" Padding="12,6"
                                            Command="{Binding $parent[UserControl].((vm:ReleaseListViewModel)DataContext).InstallCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
